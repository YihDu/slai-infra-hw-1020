# from tvm.script import tirx as T

@T.prim_func
def matmul(A: T.handle, B: T.handle, C_handle: T.handle):
    T.func_attr({"tilelang_out_idx": [-1]})
    A_1 = T.match_buffer(A, (2048, 2048), "float16", strides=(2048, 1))
    B_1 = T.match_buffer(B, (2048, 2048), "float16", strides=(2048, 1))
    C = T.match_buffer(C_handle, (2048, 2048), "float16", strides=(2048, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(32, thread="blockIdx.x"):
        for by in T.thread_binding(32, thread="blockIdx.y"):
            tx: T.int32 = T.launch_thread_idx(0)
            ty: T.int32 = T.launch_thread_idx(1)
            tz: T.int32 = T.launch_thread_idx(2)
            with T.sblock("tilelang_root"):
                T.reads()
                T.writes()
                T.sblock_attr({"tl.launch_threads": [256, 1, 1]})
                a_s = T.sblock_alloc_buffer((64, 32), "float16", scope="shared.dyn")
                b_s = T.sblock_alloc_buffer((32, 64), "float16", scope="shared.dyn")
                acc = T.sblock_alloc_buffer((64, 64), scope="local.fragment")
                c_s = T.sblock_alloc_buffer((64, 64), scope="shared.dyn")
                linear: T.int32 = by * 32 + bx
                panel_index: T.int32 = linear // 256
                offset: T.int32 = linear % 256
                stride: T.int32 = T.min(8, 32 - panel_index * 8)
                by_1: T.int32 = panel_index * 8 + offset % stride
                bx_1: T.int32 = T.if_then_else(panel_index % 2 == 1, 31 - offset // stride, offset // stride)
                T.fill(T.region(acc[0, 0], 2, 64, 64), 0)
                for p in T.serial(64, annotations={"num_stages": 2}):
                    T.copy(T.region(A_1[by_1 * 64, p * 32], 1, 64, 32), T.region(a_s[0, 0], 2, 64, 32), disable_tma=T.bool(True))
                    T.copy(T.region(B_1[p * 32, bx_1 * 64], 1, 32, 64), T.region(b_s[0, 0], 2, 32, 64), disable_tma=T.bool(True))
                    T.gemm(T.region(a_s[0, 0], 1, 64, 32), T.region(b_s[0, 0], 1, 32, 64), T.region(acc[0, 0], 3, 64, 64), T.bool(False), T.bool(False), 64, 64, 32, 0, T.bool(False), 0, 0, 0)
                T.tvm_storage_sync("shared")
                T.copy(T.region(acc[0, 0], 1, 64, 64), T.region(c_s[0, 0], 2, 64, 64))
                T.tvm_storage_sync("shared")
                for i in T.parallel(64):
                    for j in T.parallel(64):
                        if by_1 * 64 + i < 2048 and bx_1 * 64 + j < 2048:
                            C[by_1 * 64 + i, bx_1 * 64 + j] = T.Cast("float16", c_s[i, j])