# from tvm.script import tirx as T

@T.prim_func
def matmul(A: T.handle, B: T.handle, C_handle: T.handle):
    T.func_attr({"tilelang_out_idx": [-1]})
    A_1 = T.match_buffer(A, (4096, 1024), "float16", strides=(1024, 1))
    B_1 = T.match_buffer(B, (1024, 4096), "float16", strides=(4096, 1))
    C = T.match_buffer(C_handle, (4096, 4096), "float16", strides=(4096, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(32, thread="blockIdx.x"):
        for by in T.thread_binding(32, thread="blockIdx.y"):
            tx: T.int32 = T.launch_thread_idx(0)
            ty: T.int32 = T.launch_thread_idx(1)
            tz: T.int32 = T.launch_thread_idx(2)
            with T.sblock("tilelang_root"):
                T.reads()
                T.writes()
                T.sblock_attr({"tl.launch_threads": [128, 1, 1]})
                a_s = T.sblock_alloc_buffer((128, 32), "float16", scope="shared.dyn")
                b_s = T.sblock_alloc_buffer((32, 128), "float16", scope="shared.dyn")
                acc = T.sblock_alloc_buffer((128, 128), scope="local.fragment")
                T.fill(T.region(acc[0, 0], 2, 128, 128), 0)
                for p in T.serial(32, annotations={"num_stages": 1}):
                    T.copy(T.region(A_1[by * 128, p * 32], 1, 128, 32), T.region(a_s[0, 0], 2, 128, 32), disable_tma=T.bool(True))
                    T.copy(T.region(B_1[p * 32, bx * 128], 1, 32, 128), T.region(b_s[0, 0], 2, 32, 128), disable_tma=T.bool(True))
                    T.gemm(T.region(a_s[0, 0], 1, 128, 32), T.region(b_s[0, 0], 1, 32, 128), T.region(acc[0, 0], 3, 128, 128), T.bool(False), T.bool(False), 128, 128, 32, 0, T.bool(False), 0, 0, 0)
                T.copy(T.region(acc[0, 0], 1, 128, 128), T.region(C[by * 128, bx * 128], 2, 128, 128))